# Скопируй в .env.local для локальной проверки.
# В Vercel добавь те же значения в Settings → Environment Variables.

# Authorization key из кабинета GigaChat API. Можно вставить как с "Basic ", так и без.
GIGACHAT_AUTH_KEY=

# Для аккаунта физлица оставь это значение.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Сначала проверяем Ultra. Если модель пока недоступна ключу — поставь GigaChat-2-Max.
GIGACHAT_MODEL=GigaChat-3-Ultra
