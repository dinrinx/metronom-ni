        "selector": "JSXOpeningElement[name.name='ArrowCDown'] > JSXAttribute[name.name='style2'] > Literal[value!=/^(?:light|regular|solid)$/]",
        "message": "<ArrowCDown> style2 must be one of 'light' | 'regular' | 'solid'."
