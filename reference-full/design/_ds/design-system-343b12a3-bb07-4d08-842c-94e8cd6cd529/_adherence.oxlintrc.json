        "selector": "JSXOpeningElement[name.name='ArrowCDown'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:16|20|24|32|64)$/]",
        "message": "<ArrowCDown> size must be one of '16' | '20' | '24' | '32' | '64'."
