{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "next-env.d.ts",
    "src/metronom/**/*.ts",
    "src/metronom/**/*.tsx",
    "src/app/(metronom)/**/*.ts",
    "src/app/(metronom)/**/*.tsx",
    "src/app/api/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
